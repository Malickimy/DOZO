{
  "name": "dozo-server",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone redirect + pairing server for the DOZO Android app (scan logging, debounce, Google review redirect).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "dev:connector": "node --watch src/connector.js",
    "dev:dashboard": "node --watch src/dashboard.js",
    "start:connector": "node src/connector.js",
    "start:dashboard": "node src/dashboard.js",
    "test": "node --test",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^8.3.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.2.1"
  }
}
