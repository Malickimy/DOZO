# Production example for the DOZO server.
#
# scripts/deploy.sh copies this file to DOZO-Server/.env on a host that has none,
# then builds and starts the two containers. Edit the result afterwards.
#
# Before exposing this server publicly:
#   - set API_TOKEN to a long random secret (the default grants full /api/* access)
#   - set DASHBOARD_CONNECTOR_SECRET to a long random secret
#   - set REDIRECT_DOMAIN to the public origin (the app builds QR links from it)
#   - set DASHBOARD_ORIGIN to the dashboard's browser origin instead of *

PORT=3000
# docker-compose.yml overrides this to /data/dozo.db (on the dozo-data volume).
DB_PATH=/data/dozo.db
REDIRECT_DOMAIN=https://track.example.com
GOOGLE_REVIEW_BASE=https://search.google.com/local/writereview
API_TOKEN=change-me-to-a-long-random-secret
DEBOUNCE_SECONDS=120
PAIRING_TTL_SECONDS=300
# Only true behind a trusted reverse proxy (it feeds client-IP debounce keys).
TRUST_PROXY=false
SEED_DEMO=false
# Comma-separated browser origins allowed to call /api/*.
DASHBOARD_ORIGIN=*
# Connector <-> dashboard shared secret (X-Connector-Secret).
DASHBOARD_CONNECTOR_SECRET=change-me-to-a-long-random-secret
# Connector: forward spooled scans to the dashboard service.
DASHBOARD_INGEST_URL=http://dashboard:3000
CONNECTOR_SPOOL_PATH=/data/scan-spool.jsonl
# Dashboard: built SPA directory inside the image.
DASHBOARD_DIST_PATH=/app/public
