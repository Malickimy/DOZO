# The dashboard defaults its API base URL to its own origin (same-origin
# deployment), so no base URL is required. Set VITE_API_BASE_URL only to point
# a build directly at a different API origin:
# VITE_API_BASE_URL=http://localhost:3000

# Dev-only: where `npm run dev` proxies /api and /health (default below).
# VITE_API_PROXY_TARGET=http://localhost:3000

# The API token is entered in the UI and stored in localStorage, not here.
