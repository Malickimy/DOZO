#!/usr/bin/env bash
#
# dx8000_server_check - Host-side connectivity check for the Papier redirect server.
#
# Runs entirely on the host (no adb/device). Curls {SERVER_URL}/health and,
# unless --no-register is given, POSTs a test pairing registration and reads
# back its pair-status. Exits non-zero on any failure.
#
# Registering requires the demo merchant to be seeded on the server
# (SEED_DEMO=true on boot, or `npm run seed`).
#
# Environment overrides:
#   SERVER_URL     server base URL  (default: http://130.162.185.144:3000)
#   API_TOKEN      shared API token (default: dev-placeholder-token)
#   MERCHANT_ID    seeded merchant  (default: demo-merchant)
#   DEVICE_SERIAL  sample serial    (default: DX8000-CHECK-<epoch>)
#   TERMINAL_ID    explicit id      (default: CHECKTERM01)
#   CURL           curl binary      (default: curl)

set -euo pipefail

SERVER_URL="${SERVER_URL:-http://130.162.185.144:3000}"
API_TOKEN="${API_TOKEN:-dev-placeholder-token}"
MERCHANT_ID="${MERCHANT_ID:-demo-merchant}"
DEVICE_SERIAL="${DEVICE_SERIAL:-DX8000-CHECK-$(date +%s)}"
TERMINAL_ID="${TERMINAL_ID:-CHECKTERM01}"
CURL="${CURL:-curl}"
REGISTER=1

usage() {
    cat <<EOF
Usage: dx8000_server_check [--no-register] [-h|--help]

Host-side check that the Papier redirect server is reachable:
  GET  \$SERVER_URL/health
  POST \$SERVER_URL/api/terminals/register   (unless --no-register)
  GET  \$SERVER_URL/api/terminals/pair-status/{code}

Options:
  --no-register   only check /health
  -h, --help      show this help

Environment overrides:
  SERVER_URL     server base URL  (default: http://130.162.185.144:3000)
  API_TOKEN      shared API token (default: dev-placeholder-token)
  MERCHANT_ID    seeded merchant  (default: demo-merchant)
  DEVICE_SERIAL  sample serial    (default: DX8000-CHECK-<epoch>)
  TERMINAL_ID    explicit id      (default: CHECKTERM01)
  CURL           curl binary      (default: curl)
EOF
}

while (( $# )); do
    case "$1" in
        -h|--help)      usage; exit 0 ;;
        --no-register)  REGISTER=0; shift ;;
        --server-url)   [[ $# -ge 2 ]] || { echo "dx8000_server_check: --server-url requires a value" >&2; exit 2; }; SERVER_URL="$2"; shift 2 ;;
        --server-url=*) SERVER_URL="${1#*=}"; shift ;;
        --token)        [[ $# -ge 2 ]] || { echo "dx8000_server_check: --token requires a value" >&2; exit 2; }; API_TOKEN="$2"; shift 2 ;;
        --token=*)      API_TOKEN="${1#*=}"; shift ;;
        -*)             echo "dx8000_server_check: unknown option: $1" >&2; usage >&2; exit 2 ;;
        *)              echo "dx8000_server_check: unexpected argument: $1" >&2; usage >&2; exit 2 ;;
    esac
done

if ! command -v "$CURL" >/dev/null 2>&1; then
    echo "ERROR: curl not found: $CURL" >&2
    exit 1
fi

BODY_FILE="$(mktemp)"
trap 'rm -f "$BODY_FILE"' EXIT

# request <METHOD> <PATH> [JSON_BODY] -> prints HTTP status, body to $BODY_FILE
request() {
    local method="$1" path="$2" data="${3:-}" status
    local args=(-sS -o "$BODY_FILE" -w '%{http_code}' -X "$method")
    if [[ -n "$API_TOKEN" ]]; then
        args+=(-H "X-Api-Token: $API_TOKEN")
    fi
    if [[ -n "$data" ]]; then
        args+=(-H 'Content-Type: application/json' --data "$data")
    fi
    status="$("$CURL" "${args[@]}" "$SERVER_URL$path")" || return 1
    printf '%s' "$status"
}

fail=0

echo "==> GET $SERVER_URL/health"
status="$(request GET /health)" || { echo "ERROR: curl failed for /health" >&2; exit 1; }
echo "HTTP $status"
cat "$BODY_FILE"; echo
if [[ "$status" != "200" ]]; then
    fail=1
    echo "ERROR: expected 200 from /health" >&2
fi

if (( REGISTER )); then
    register_body="$(printf '{"device_serial":"%s","merchant_id":"%s","terminal_id":"%s"}' \
        "$DEVICE_SERIAL" "$MERCHANT_ID" "$TERMINAL_ID")"

    echo
    echo "==> POST $SERVER_URL/api/terminals/register"
    status="$(request POST /api/terminals/register "$register_body")" \
        || { echo "ERROR: curl failed for /api/terminals/register" >&2; exit 1; }
    echo "HTTP $status"
    cat "$BODY_FILE"; echo
    if [[ "$status" != "201" ]]; then
        fail=1
        echo "ERROR: expected 201 from register (is merchant '$MERCHANT_ID' seeded?)" >&2
    fi

    code="$(sed -n 's/.*"code"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$BODY_FILE")"
    if [[ -z "$code" ]]; then
        fail=1
        echo "ERROR: could not extract a pairing code from the register response" >&2
    else
        echo
        echo "==> GET $SERVER_URL/api/terminals/pair-status/$code"
        status="$(request GET "/api/terminals/pair-status/$code")" \
            || { echo "ERROR: curl failed for pair-status" >&2; exit 1; }
        echo "HTTP $status"
        cat "$BODY_FILE"; echo
        if [[ "$status" != "202" && "$status" != "200" ]]; then
            fail=1
            echo "ERROR: expected 202 (pending) or 200 (claimed) from pair-status" >&2
        fi
    fi
fi

echo
if (( fail )); then
    echo "dx8000_server_check: FAILED" >&2
    exit 1
fi
echo "dx8000_server_check: OK"
