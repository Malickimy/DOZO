#!/usr/bin/env bash
#
# dozo_verify_qr - Screencap the device, decode the on-screen QR with zbarimg,
# and assert the payload equals the expected review URL.
#
# The default matches a default dozo_trigger_intent run: the app builds
# {redirectBaseUrl}/r/{terminal_id} with redirectBaseUrl https://track.papier.app
# and terminal_id DEMOTERM01.
#
# Exit codes: 0 = PASS (payload matches), 1 = FAIL (mismatch / no QR / error).
#
# Environment overrides:
#   ANDROID_HOME   Android SDK root (default: $ANDROID_SDK_ROOT, else ~/Library/Android/sdk)
#   ADB            adb binary       (default: $ANDROID_HOME/platform-tools/adb)
#   SERIAL         target device    (default: emulator-5554)
#   ZBARIMG        zbarimg binary   (default: /usr/local/bin/zbarimg)
#   QR_TIMEOUT     seconds to keep polling for the QR (default: 10)

set -euo pipefail

ANDROID_HOME="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-$HOME/Library/Android/sdk}}"
ADB="${ADB:-$ANDROID_HOME/platform-tools/adb}"
SERIAL="${SERIAL:-emulator-5554}"
ZBARIMG="${ZBARIMG:-/usr/local/bin/zbarimg}"
DEFAULT_URL="https://track.papier.app/r/DEMOTERM01"
QR_TIMEOUT="${QR_TIMEOUT:-10}"

expect="$DEFAULT_URL"

usage() {
    cat <<EOF
Usage: dozo_verify_qr [<url> | --expect <url>] [--timeout N] [-h|--help]

Capture the screen, decode the QR and compare its payload to the expected URL.
The default matches a default dozo_trigger_intent run (redirectBaseUrl
https://track.papier.app + terminal_id DEMOTERM01).
The QR is polled for up to \$QR_TIMEOUT seconds to tolerate cold-start rendering.

Arguments / options:
  <url>               expected payload (positional)
  --expect <url>      expected payload (default: $DEFAULT_URL)
  --timeout N         seconds to keep polling for the QR (default: \$QR_TIMEOUT or 10)
  -h, --help          show this help

Environment overrides:
  ANDROID_HOME, ADB, SERIAL, ZBARIMG, QR_TIMEOUT
EOF
}

while (( $# )); do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --expect)  [[ $# -ge 2 ]] || { echo "dozo_verify_qr: --expect requires a value" >&2; exit 2; }; expect="$2"; shift 2 ;;
        --expect=*) expect="${1#*=}"; shift ;;
        --timeout) [[ $# -ge 2 ]] || { echo "dozo_verify_qr: --timeout requires a value" >&2; exit 2; }; QR_TIMEOUT="$2"; shift 2 ;;
        --timeout=*) QR_TIMEOUT="${1#*=}"; shift ;;
        -*) echo "dozo_verify_qr: unknown option: $1" >&2; usage >&2; exit 2 ;;
        *) expect="$1"; shift ;;
    esac
done

if [[ ! "$QR_TIMEOUT" =~ ^[0-9]+$ ]]; then
    echo "dozo_verify_qr: --timeout must be a non-negative integer, got: $QR_TIMEOUT" >&2
    exit 2
fi

if [[ ! -x "$ADB" ]]; then
    echo "ERROR: adb not found or not executable: $ADB" >&2
    exit 1
fi
if [[ ! -x "$ZBARIMG" ]]; then
    echo "ERROR: zbarimg not found or not executable: $ZBARIMG" >&2
    exit 1
fi

tmp="$(mktemp "${TMPDIR:-/tmp}/dozo-qr.XXXXXX.png")"
cleanup() { rm -f "$tmp"; }
trap cleanup EXIT

deadline=$((SECONDS + QR_TIMEOUT))
payload=""
last_rc=1
while :; do
    "$ADB" -s "$SERIAL" exec-out screencap -p >"$tmp" 2>/dev/null || true
    if [[ ! -s "$tmp" ]]; then
        echo "FAIL: screencap produced an empty image ($tmp)" >&2
        exit 1
    fi

    set +e
    payload="$("$ZBARIMG" --quiet --raw "$tmp" 2>/dev/null)"
    last_rc=$?
    set -e

    if (( last_rc == 0 )) && [[ -n "$payload" ]]; then
        # If several symbols were decoded, keep the first line.
        payload="$(printf '%s\n' "$payload" | head -n 1)"
        if [[ "$payload" == "$expect" ]]; then
            echo "PASS: $payload"
            exit 0
        fi
        # A decoded but unexpected payload may still be mid-render; keep polling.
    fi

    if (( SECONDS >= deadline )); then
        break
    fi
    sleep 1
done

if (( last_rc != 0 )) || [[ -z "$payload" ]]; then
    echo "FAIL: no QR code found in screenshot (zbarimg exit $last_rc)" >&2
    exit 1
fi

echo "FAIL: expected '$expect' got '$payload'" >&2
exit 1
