{
  "$schema": "https://opencode.ai/config.json",
  "references": {
    "dozo-app": {
      "path": "./DOZO-App",
      "description": "Use for the Android terminal app (Kotlin/Gradle, intents, pairing, mockpay). Read before writing QA for an app-side change."
    },
    "dozo-server": {
      "path": "./DOZO-Server",
      "description": "Use for the Fastify + SQLite redirect server (routes, schema, tests). Read before writing API QA for a server change."
    },
    "dozo-dashboard": {
      "path": "./DOZO-Dashboard",
      "description": "Use for the Vite + React merchant portal (components, flows, vitest setup). Read before writing browser QA for a dashboard change."
    },
    "root": {
      "path": ".",
      "description": "Use for CONTRACTS.md, MANUAL.md, AGENTS.md, and repo-wide conventions. Read to ground contract and cross-cutting QA."
    }
  },
  "mcp": {
    "firecrawl": {
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp"],
      "enabled": false,
      "environment": {
        "FIRECRAWL_API_KEY": "{env:FIRECRAWL_API_KEY}"
      },
      "alwaysAllow": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--headless"],
      "enabled": false
    },
    "sqlite": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@database-mcp/sqlite",
        "--dsn",
        "{env:DOZO_DB_PATH}"
      ],
      "enabled": false
    },
    "docker": {
      "type": "local",
      "command": ["docker", "mcp", "gateway", "run"],
      "enabled": false
    },
    "ssh": {
      "type": "local",
      "command": ["/Users/malicky/.local/bin/uvx", "safe-ssh-mcp"],
      "enabled": false
    },
    "mobile-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@mobilenext/mobile-mcp@latest"],
      "enabled": true,
      "environment": {
        "MOBILEMCP_DISABLE_TELEMETRY": "1",
        "PATH": "/Users/malicky/Library/Android/sdk/platform-tools:/Users/malicky/.local/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "maps": {
      "type": "remote",
      "url": "https://mapstools.googleapis.com/mcp",
      "enabled": false
    },
    "android-mcp-server": {
      "type": "local",
      "command": [
        "/Users/malicky/.local/bin/uv",
        "--directory",
        "/Users/malicky/l/android-mcp-server",
        "run",
        "server.py"
      ],
      "enabled": true,
      "environment": {
        "PATH": "/Users/malicky/Library/Android/sdk/platform-tools:/Users/malicky/.local/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    "uiautomator2-mcp-server": {
      "type": "local",
      "command": ["/Users/malicky/.local/bin/uiautomator2-mcp-server", "stdio"],
      "enabled": true,
      "environment": {
        "PATH": "/Users/malicky/Library/Android/sdk/platform-tools:/Users/malicky/.local/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    "android-builder-mcp": {
      "type": "local",
      "command": [
        "/Users/malicky/.local/bin/uv",
        "run",
        "--project",
        "/Users/malicky/l/android-builder-mcp",
        "/Users/malicky/l/android-builder-mcp/server.py"
      ],
      "enabled": true,
      "environment": {
        "ANDROID_PROJECT_DIR": "./DOZO-App",
        "JAVA_HOME": "/Users/malicky/Library/Java/JavaVirtualMachines/openjdk-25.0.1/Contents/Home",
        "PATH": "/Users/malicky/.local/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    "jetbrains-psi-mcp-server": {
      "type": "local",
      "command": ["npx", "-y", "jetbrains-psi-mcp-server"],
      "enabled": false
    }
  },
  "tools": {
    "firecrawl_*": false,
    "context7_*": false,
    "playwright_*": false,
    "chrome-devtools_*": false,
    "sqlite_*": false,
    "docker_*": false,
    "ssh_*": false,
    "mobile-mcp_*": true,
    "github_*": true,
    "maps_*": false,
    "android-mcp-server_*": true,
    "uiautomator2-mcp-server_*": true,
    "android-builder-mcp_*": true,
    "jetbrains-psi-mcp-server_*": false
  }
}
